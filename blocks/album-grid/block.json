{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "stackfolio/album-grid",
	"version": "1.0.0",
	"title": "StackFolio Albums",
	"category": "media",
	"icon": "format-gallery",
	"description": "A filterable grid of photo and video albums. Each cover opens the full album in a lightbox.",
	"keywords": [ "gallery", "album", "photos", "videos", "lightbox", "portfolio" ],
	"textdomain": "stackfolio",
	"attributes": {
		"categories": { "type": "array", "items": { "type": "integer" }, "default": [] },
		"number": { "type": "integer", "default": 0 },
		"orderby": { "type": "string", "default": "date" },
		"order": { "type": "string", "default": "DESC" },
		"columns": { "type": "integer", "default": 3 },
		"columnsTablet": { "type": "integer", "default": 2 },
		"columnsMobile": { "type": "integer", "default": 1 },
		"gap": { "type": "integer", "default": 20 },
		"hover": { "type": "string", "default": "zoom" },
		"showTitle": { "type": "boolean", "default": true },
		"titleTag": { "type": "string", "default": "h3" },
		"titleAlign": { "type": "string", "default": "center" },
		"showCount": { "type": "boolean", "default": false },
		"filters": { "type": "boolean", "default": false },
		"filterAll": { "type": "boolean", "default": true },
		"allLabel": { "type": "string", "default": "" },
		"filterAlign": { "type": "string", "default": "center" },
		"videos": { "type": "boolean", "default": true },
		"thumbnails": { "type": "boolean", "default": true },
		"hideThumbsFullscreen": { "type": "boolean", "default": false },
		"zoom": { "type": "boolean", "default": true },
		"fullscreen": { "type": "boolean", "default": true },
		"slideshow": { "type": "boolean", "default": true },
		"slideshowAutostart": { "type": "boolean", "default": false },
		"captions": { "type": "boolean", "default": true },
		"download": { "type": "boolean", "default": false }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "file:./index.js",
	"style": "stackfolio",
	"viewScript": "stackfolio"
}
